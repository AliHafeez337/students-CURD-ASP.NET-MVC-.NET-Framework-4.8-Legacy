@model CrudApp.Models.Student

@{
    ViewBag.Title = "Delete Student";
}

<h2>Delete Student</h2>

@* Show the student details before asking for confirmation *@
@* We never delete without showing the user what they are deleting *@
<div class="alert alert-danger">
    <h4>Are you sure you want to delete this student?</h4>
</div>

<table class="table table-bordered">
    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>
    <tr>
        <th>Age</th>
        <td>@Model.Age</td>
    </tr>
    <tr>
        <th>Email</th>
        <td>@Model.Email</td>
    </tr>
    <tr>
        <th>Grade</th>
        <td>@Model.Grade</td>
    </tr>
</table>

@* This form POSTs to the DeleteConfirmed action in the controller *@
@using (Html.BeginForm("Delete", "Students", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @* Pass the student Id so controller knows which student to delete *@
    @Html.HiddenFor(m => m.Id)

    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    @Html.ActionLink("No, Cancel", "Index", null, new { @class = "btn btn-default" })
}